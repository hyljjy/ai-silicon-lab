report_checks \
  -from [all_inputs -no_clocks] \
  -to [all_registers -data_pins] \
  -through [get_pins {_11509_/Y}] \
  -path_delay max \
  -scene ss_n40C_1v60 \
  -sort_by_slack \
  -group_count 50 \
  -endpoint_count 50 \
  -format full_clock_expanded \
  -fields {slew cap input_pins fanout} \
  -digits 4
